@model IEnumerable<Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách sản phẩm</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th class="text-end">Giá chuẩn</th>
            <th class="text-end">Giá khuyến mãi</th>
            <th style="width:220px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td><img src="~/products/@item.Image" alt="@item.Name" style="height:60px" /></td>
                <td>@item.Name</td>
                <td>@item.Category?.Name</td>
                <td class="text-end">@item.Price.ToString("N0")</td>
                <td class="text-end">@item.SalePrice.ToString("N0")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">Chưa có sản phẩm nào</td></tr>
        }
    </tbody>
</table>

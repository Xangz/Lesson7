@model Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h2>Xóa sản phẩm</h2>
<h5 class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này không?</h5>
<div class="row mb-3">
    <div class="col-md-3"><img src="~/products/@Model.Image" class="img-fluid rounded" /></div>
    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Tên sản phẩm</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@Model.Category?.Name</dd>
            <dt class="col-sm-3">Giá chuẩn</dt><dd class="col-sm-9">@Model.Price.ToString("N0")</dd>
            <dt class="col-sm-3">Giá khuyến mãi</dt><dd class="col-sm-9">@Model.SalePrice.ToString("N0")</dd>
        </dl>
    </div>
</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
